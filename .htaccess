RewriteEngine On

# 1. Map URL tanpa ekstensi ke file .php
# Contoh: /login -> /login.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# 2. Redirect jika user mengakses langsung file .php ke URL bersih
# Contoh: /login.php -> /login
RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
